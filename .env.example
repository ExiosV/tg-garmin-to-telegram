# Secrets (k8s: ExternalSecret tg-garmin-to-telegram-secrets backed by Bitwarden; keys are named
# tg-garmin-to-telegram__tg-garmin-to-telegram-secrets__<KEY>)
TELEGRAM_BOT_TOKEN=          # the service bot (serves /start and diagnostics); users deliver with their own bot tokens
TELEGRAM_CHANNEL_ID=         # optional: self-check only (`check` prints its title); NOT the multi-user delivery path
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=        # Gmail mailbox that receives Garmin LiveTrack mail (scope gmail.readonly)
# Optional
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
GMAIL_QUERY=from:garmin.com to:garmin-telegram newer_than:2d
DATA_DIR=./data
POLL_SECONDS=30
MAX_AGE_HOURS=12             # mails older than this are not announced after an outage
INGEST_PORT=8080             # ingest HTTP API port (onboarding webhooks come later)
INGEST_TOKEN=                # cluster-internal bearer for the ingest API
WEB_SESSION_SECRET=          # placeholder: web onboarding will sign its sessions with it
OWNER_NAME=the rider         # how the bot names the owner in messages
